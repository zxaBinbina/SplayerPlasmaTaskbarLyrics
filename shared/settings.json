    "options": [
      { "label": "打开 SPlayer / Open SPlayer", "value": "open" },
      { "label": "播放我喜欢的音乐 / Play liked songs", "value": "liked" }
    ]
  },
  {
    "key": "offlineDisplay",
    "type": "select",
    "label": "SP 未运行 / When SP is closed",
