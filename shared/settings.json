    "options": [
      {
        "label": "收起为图标 / Icon",
        "value": "icon"
      },
      {
        "label": "隐藏 / Hide",
        "value": "hidden"
      }
    ]
  },
  {
    "key": "offlineClick",
    "type": "select",
    "label": "SP 关闭时点击 / Click when SP is closed",
    "default": "launch",
    "options": [
      {
        "label": "按空闲时设置执行 / Use the idle click setting",
        "value": "launch"
      },
      {
        "label": "无操作 / Do nothing",
        "value": "none"
      }
    ]
  },
  {
    "key": "clickLyricSeek",
    "type": "switch",
    "label": "点击歌词跳转 / Seek by clicking lyrics",
