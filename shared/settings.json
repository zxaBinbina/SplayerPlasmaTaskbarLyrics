  {
    "key": "themeMode",
    "type": "select",
    "label": "主题来源 / Theme source",
    "default": "splayer",
    "options": [
      {
        "label": "跟随 SP / Follow SP",
        "value": "splayer"
      },
      {
        "label": "跟随 Plasma / Follow Plasma",
        "value": "plasma"
      },
      {
        "label": "手动 / Manual",
        "value": "manual"
      }
    ]
  },
  {
    "key": "manualDark",
    "type": "switch",
    "label": "手动暗色 / Manual dark mode",
    "default": true
