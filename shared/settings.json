[
  {
    "key": "lyricMode",
    "type": "select",
    "label": "歌词模式 / Lyric layout",
    "default": "double",
    "options": [
      {
        "label": "双行歌词 / Two lyric lines",
        "value": "double"
      },
      {
        "label": "单行歌词＋歌曲信息 / Lyric + song information",
        "value": "single"
      }
    ]
  },
  {
    "key": "auxiliary",
    "type": "select",
    "label": "辅助歌词 / Secondary lyric",
    "default": "translation",
    "options": [
      {
        "label": "翻译 / Translation",
        "value": "translation"
      },
      {
        "label": "音译 / Romanization",
        "value": "romanization"
      },
      {
        "label": "关闭，显示下一句 / Next line",
        "value": "off"
      }
    ]
  },
  {
    "key": "singlePreferAux",
    "type": "switch",
    "label": "单行优先辅助歌词 / Prefer secondary in single mode",
    "default": false
  },
  {
    "key": "fontSize",
    "type": "number",
    "label": "基准字号（42 像素高时） / Reference font size (at 42px height)",
    "default": 14,
    "min": 9,
    "max": 32
  },
  {
    "key": "animationsEnabled",
    "type": "switch",
    "label": "界面动画 / Interface animations",
    "default": true
  },
  {
    "key": "coverPosition",
    "type": "select",
    "label": "封面位置 / Cover position",
    "default": "left",
    "options": [
      {
        "label": "左侧 / Left",
        "value": "left"
      },
      {
        "label": "右侧 / Right",
        "value": "right"
      }
    ]
  },
  {
    "key": "coverShape",
    "type": "select",
    "label": "封面形状 / Cover shape",
    "default": "square",
    "options": [
      { "label": "方形 / Square", "value": "square" },
      { "label": "圆角方形 / Rounded square", "value": "rounded" },
      { "label": "圆形 / Circle", "value": "circle" }
    ]
  },
  {
    "key": "coverRadius",
    "type": "number",
    "label": "圆角程度（1–49%） / Corner rounding (1–49%)",
