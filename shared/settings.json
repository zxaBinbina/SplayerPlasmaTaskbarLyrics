    "options": [
      {
        "label": "完整歌词面板 / Full lyrics",
        "value": "popup"
      },
      {
        "label": "无操作 / Do nothing",
        "value": "none"
      },
      {
        "label": "打开 SP / Open SP",
        "value": "open"
      }
    ]
  },
  {
    "key": "idleClick",
    "type": "select",
    "label": "显示“未在播放”时点击 / Body click with no song",
