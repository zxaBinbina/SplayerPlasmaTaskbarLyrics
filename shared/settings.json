  {
    "key": "widthMode",
    "type": "select",
    "label": "宽度模式 / Width mode",
    "default": "auto",
    "options": [
      {
        "label": "自动 / Automatic",
        "value": "auto"
      },
      {
        "label": "固定 / Fixed",
        "value": "fixed"
      }
    ]
  },
  {
    "key": "fixedWidth",
    "type": "number",
    "label": "固定宽度 / Fixed width",
    "default": 320,
    "min": 180,
    "max": 1200
