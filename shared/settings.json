  {
    "key": "maxWidth",
    "type": "number",
    "label": "自动最大宽度 / Maximum automatic width",
    "default": 420,
    "min": 180,
    "max": 1200
  },
  {
    "key": "hoverFavoriteEnabled",
    "type": "switch",
    "label": "悬停时显示收藏按钮 / Show favorite button on hover",
